# Exclude licence and attribution notices from GitHub language statistics.
notices/** linguist-documentation
# Preserve upstream runner licence and attribution bytes on every platform.
notices/mod-runtime/** -text -whitespace

# Bash helpers must remain runnable after a Windows checkout and ZIP extraction.
*.sh text eol=lf

# Keep shared runner build inputs identical on Linux and Windows checkouts.
mod_runtime/**/*.py text eol=lf
mod_runtime/*/runner.wit text eol=lf
LICENCE text eol=lf
