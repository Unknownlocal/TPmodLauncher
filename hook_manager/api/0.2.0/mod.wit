package modlauncher:api@0.2.0;

/// Feature switches select bindings; runtime grants still enforce permissions.
world code-mod {
    /// Requires diagnostics permission; the host attaches the calling mod's ID.
    @unstable(feature = diagnostics)
    import report: func(message: string);

    /// Register a native menu row with a short confirmation displayed when clicked.
    /// Requires main-menu; the host supplies ownership and removes it on failure/exit.
    @unstable(feature = main-menu)
    import add-menu-button: func(id: string, label: string, message: string);

    /// Called once by trusted infrastructure after component admission.
    export activate: func();

    /// Bounded JSON plain values, interpreted only by the approved event adapter.
    /// An event name does not grant access to a game target or operation.
    export on-event: func(name: string, payload: string) -> string;
}
