// Private runner ABI. This does not publish source mod API 0.4.0.
package modlauncher:python-runner@0.4.0;

world code-runner {
    import report: func(message: string);
    import add-menu-button: func(id: string, label: string, message: string);
    import register-settings: func(definition: string) -> string;
    import save-settings: func(values: string) -> string;
    import register-theme: func(definition: string);

    export put-source: func(path: string, chunk: string);
    export load-source: func(entry: string) -> string;
    export activate: func();
    export on-event: func(name: string, payload: string) -> string;
    export bind-regulation: func(index: u32, declaration: string) -> string;

    // Resident policy/action operations are private, not author capabilities.
    export begin-regulation-policy: func(epoch: u64, generation: u64, manifest-bytes: u32) -> string;
    export put-regulation-policy: func(chunk: string);
    export seal-regulation-policy-manifest: func() -> string;
    export install-regulation-records: func(page: string) -> string;
    export begin-regulation-record: func(slot: u32, bytes: u32);
    export put-regulation-record: func(chunk: string);
    export seal-regulation-record: func() -> string;
    export seal-regulation-policy: func() -> string;
    export commit-regulation-policy: func(epoch: u64, generation: u64) -> string;
    export reset-regulation-career: func(epoch: u64) -> string;
    export begin-regulation-action: func(action: u64, epoch: u64, generation: u64, bytes: u32, first: string) -> string;
    export put-regulation-action: func(chunk: string);
    export seal-regulation-action: func() -> string;
    export prepare-regulation-slots: func(action: u64) -> string;
    export validate-resident-regulation: func(action: u64, slot: u32) -> string;
    export discard-regulation-action: func(action: u64);
}
